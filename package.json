{
  "name": "nexus-devflow",
  "version": "2.14.0",
  "description": "Enterprise-grade spec-driven development framework for multi-agent workflows",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "npm run typecheck && tsx scripts/check-devflow.ts",
    "check:static": "tsx scripts/validate-framework.ts",
    "check:upstream": "tsx scripts/check-upstream-drift.ts",
    "overview": "tsx ./scripts/overview.ts --write",
    "typecheck": "tsc --noEmit",
    "dashboard": "tsx packages/create-nexus-devflow/bin/create-nexus-devflow.ts dashboard",
    "ui": "tsx packages/create-nexus-devflow/bin/create-nexus-devflow.ts dashboard",
    "status": "tsx packages/create-nexus-devflow/bin/create-nexus-devflow.ts status",
    "sync:adapters": "node ./scripts/sync-adapters.js",
    "test": "npm --prefix packages/create-nexus-devflow test && npm run test:overview && npm run test:sandbox && npm run test:run-state && npm run test:tooling",
    "test:tooling": "tsx --test scripts/test/*.test.ts",
    "test:evals": "tsx ./scripts/evals/routing.ts",
    "test:routing": "tsx ./scripts/evals/routing.ts",
    "test:run-state": "tsx --test scripts/run-state-helper.test.ts",
    "test:sandbox": "tsx --test scripts/clear-sandbox.test.ts scripts/scaffold-sandbox.test.ts",
    "test:e2e": "tsx scripts/e2e/run.ts",
    "test:browser": "playwright test",
    "test:package": "tsx ./scripts/smoke-package.ts",
    "test:overview": "tsx --test scripts/overview.test.ts",
    "sandbox:scaffold": "tsx scripts/scaffold-sandbox.ts",
    "sandbox:clear": "tsx scripts/clear-sandbox.ts",
    "link:local": "tsx scripts/link-local.ts",
    "unlink:local": "tsx scripts/link-local.ts --undo",
    "release:tag": "tsx scripts/tag-release.ts",
    "activate": "node ./scripts/activate-agent.mjs",
    "goal": "node ./scripts/goal-runner.mjs",
    "index": "node ./scripts/generate-project-index.mjs",
    "link-project": "tsx scripts/tooling.ts link-project",
    "migrate:artifacts": "tsx scripts/tooling.ts migrate-stage-artifacts",
    "tooling": "tsx scripts/tooling.ts",
    "render:html": "tsx scripts/tooling.ts render-html",
    "render:html:test": "node ./scripts/test-render-html-core.mjs",
    "report:html": "tsx scripts/tooling.ts report-html",
    "report:html:test": "node ./scripts/test-generate-report-html.mjs",
    "artifact-language:switch": "tsx scripts/tooling.ts switch-artifact-language",
    "artifact-language:test": "node ./scripts/test-switch-artifact-language.mjs",
    "validate:manual-review:test": "node ./scripts/test-manual-review-contract.mjs",
    "validate:stage-content:test": "node ./scripts/test-stage-content-contract.mjs",
    "validate:run-status:test": "node ./scripts/test-summarize-run-status.mjs",
    "validate:checklists:test": "node ./scripts/test-validate-checklists.mjs",
    "validate:skills:test": "node ./scripts/test-skill-selection-policy.mjs",
    "validate:verify-impact:test": "node ./scripts/test-verify-impact-contract.mjs",
    "roadmap:validate": "tsx ./scripts/validate-framework.ts --roadmap-only",
    "security:scan": "tsx scripts/tooling.ts scan-security-hygiene",
    "sync:check": "node ./scripts/sync-agent-bundle.mjs",
    "validate": "tsx ./scripts/validate-framework.ts",
    "validate:docs": "tsx scripts/tooling.ts scan-doc-contract"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "bin": {
    "nexus-devflow": "./scripts/activate-agent.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT"
}
