# Nexus-DevFlow - Git Ignore

# Node.js dependencies & package manager locks / logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.log.*

# Build, Bundles & Generated Distribution Outputs
dist/
build/
out/
*.tgz
*.tar.gz
graphify-out/
.astro/

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Environment & Security
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
.security-key

# DevFlow Transient Runtime Data, Research & Scratch Files
devflow/runs/*
!devflow/runs/.gitkeep
devflow/discoveries/*
!devflow/discoveries/.gitkeep
devflow/reports/*
!devflow/reports/.gitkeep
devflow/research/*
!devflow/research/.gitkeep
devflow/scratch/*
!devflow/scratch/.gitkeep
devflow/decisions/*
!devflow/decisions/.gitkeep
!devflow/decisions/README.md
devflow/inbox/*/raw/*
devflow/inbox/raw/*
devflow/analysis/*
!devflow/analysis/.gitkeep
devflow/tmp/*
devflow/temp/*
devflow/brainstorm/*
devflow/brainstorms/*
devflow/backups/*
devflow/docs/playbooks/
evals/results/

