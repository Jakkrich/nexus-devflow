# Nexus-DevFlow - Git Ignore

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Build & generated outputs
dist/
build/
*.tgz
graphify-out/

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# Environment & Security
.env
.env.local
.env.*.local
*.pem
.security-key

# DevFlow transient run data, research, brainstorm & scratch files
devflow/runs/*
!devflow/runs/.gitkeep
devflow/discoveries/*
!devflow/discoveries/.gitkeep
devflow/reports/*
!devflow/reports/.gitkeep
devflow/research/*
!devflow/research/.gitkeep
devflow/brainstorm/*
devflow/brainstorms/*
devflow/scratch/*
devflow/tmp/*

.devflow/
.nexus/branches/*

# Local databases & state files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python cache & virtualenvs (if applicable)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
# Website build output
.astro/

.agent-backup/