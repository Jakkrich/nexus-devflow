# Nexus-DevFlow - Git Ignore

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Build & tarball outputs
dist/
build/
*.tgz

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# Environment & Security
.env
.env.local
.env.*.local
*.pem
.security-key

# DevFlow transient run data & scratch files
devflow/runs/*
!devflow/runs/.gitkeep
devflow/discoveries/*
!devflow/discoveries/.gitkeep
devflow/reports/*
!devflow/reports/.gitkeep

# Python cache & virtualenvs (if applicable)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
