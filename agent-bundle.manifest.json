{
  "source_bundle": ".agents",
  "description": "Single-source manifest for the active Nexus-DevFlow agent adapters.",
  "required_paths": [
    ".agents/skills",
    ".claude/skills",
    ".nexus/nexus-devflow.json",
    "devflow/context/project-overview.md",
    "devflow/context/coding-standards.md",
    "devflow/context/ai-interaction.md",
    "devflow/context/findings.md",
    "devflow/reference/running-id-contract.md"
  ],
  "forbidden_legacy_paths": [
    ".agent",
    ".cursor",
    ".windsurf"
  ],
  "commands": {
    "check": "npm run check",
    "validate": "npm run check:static",
    "test": "npm test"
  }
}
