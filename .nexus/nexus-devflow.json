{
  "schemaVersion": 1,
  "name": "nexus-devflow",
  "package": "@jakkrichm/create-nexus-devflow",
  "version": "2.0.1",
  "repository": "https://github.com/Jakkrich/nexus-devflow",
  "artifactLanguage": "th",
  "adapters": [
    "claude",
    "codex"
  ],
  "workspace": {
