{
  "schemaVersion": 1,
  "name": "nexus-devflow",
  "package": "@jakkrichm/create-nexus-devflow",
  "version": "2.0.27",
  "repository": "https://github.com/Jakkrich/nexus-devflow",
  "artifactLanguage": "th",
  "adapters": [
    "antigravity",
    "claude",
    "codex",
    "copilot"
  ],
  "workspace": {
    "contextDir": "devflow/context",
    "historyDir": "devflow/history",
    "referenceDir": "devflow/reference",
    "runsDir": "devflow/runs",
    "discoveriesDir": "devflow/discoveries"
  },
  "lifecycle": {
    "fastTrackStages": [
      "feature",
      "fix",
      "implement",
      "check",
      "complete"
    ],
    "mainlineStages": [
      "00-explore",
      "10-define",
      "20-spec",
      "30-plan",
      "40-execute",
      "50-verify",
      "60-report",
      "70-deliver"
    ],
    "companionCommands": [
      "devflow",
      "doctor",
      "overview",
      "debug",
      "onboard",
      "adopt",
      "try",
      "rollback",
      "idea",
      "ci",
      "test",
      "autopilot",
      "prototype",
      "report-html",
      "brief",
      "discovery",
      "audit",
      "release"
    ]
  },
  "installedAt": "2026-08-17T00:00:00.000Z"
}