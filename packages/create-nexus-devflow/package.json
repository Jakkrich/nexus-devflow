{
  "name": "@jakkrichm/create-nexus-devflow",
  "version": "2.10.0",
  "description": "Installer and workflow manager for Nexus-DevFlow agentic workflow layer.",
  "license": "MIT",
  "author": "Jakkrich",
  "homepage": "https://github.com/Jakkrich/nexus-devflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakkrich/nexus-devflow.git",
    "directory": "packages/create-nexus-devflow"
  },
  "bugs": {
    "url": "https://github.com/Jakkrich/nexus-devflow/issues"
  },
  "keywords": [
    "devflow",
    "nexus-devflow",
    "ai",
    "ai-coding",
    "antigravity",
    "codex",
    "claude-code",
    "agent",
    "workflow",
    "scaffold"
  ],
  "type": "module",
  "bin": {
    "create-nexus-devflow": "dist/bin/create-nexus-devflow.js",
    "nexus-devflow": "dist/bin/create-nexus-devflow.js",
    "devflow": "dist/bin/create-nexus-devflow.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check:pack": "npm pack --dry-run",
    "prepare-template": "tsx scripts/prepare-template.ts",
    "clean-template": "tsx scripts/clean-template.ts",
    "prepack": "npm run build && npm run prepare-template",
    "postpack": "npm run clean-template"
  },
  "files": [
    "dist/",
    "template/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
