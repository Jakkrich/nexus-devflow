{
  "schemaVersion": 1,
  "workflow": {
    "stepReview": "feature",
    "checkpointCommits": "disabled",
    "role": "full"
  },
  "git": {
    "featureBranchPrefix": "feature/",
    "fixBranchPrefix": "fix/",
    "rollbackBranchPrefix": "rollback/"
  },
  "verification": {
    "logicTests": "when-configured",
    "uiEvidence": "when-available"
  },
  "review": {
    "independentExecution": "automatic"
  },
  "execution": {
    "tier": "auto",
    "autoApproveSpec": true,
    "autoCommitFeatureBranch": true
  },
  "delivery": {
    "gate": "option-a-evidence-packet"
  },
  "qualityGates": {
    "regular": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "specCheck": "manual",
      "tryGuide": "manual"
    },
    "continuous": {
      "audit": "manual",
      "independentReview": "when-sensitive",
      "check": "manual",
      "specCheck": "manual",
      "tryGuide": "manual"
    }
  },
  "continuous": {
    "maxFeatures": null,
    "maxRepairAttempts": 2,
    "finalIntegrationAudit": false
  }
}
